{
    "title": "Lazada Product Data Scraper",
    "description": "Search Lazada across 6 SEA countries. Supports batch keywords, price/rating filters, sorting, cross-country price comparison, and more.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "mode": {
            "sectionCaption": "Search Mode",
            "title": "Mode",
            "type": "string",
            "description": "Search by keyword or directly by Lazada URL",
            "editor": "select",
            "default": "keyword",
            "enum": ["keyword", "url"],
            "enumTitles": ["Search by Keyword", "Search by URL"]
        },
        "keywords": {
            "title": "Keywords",
            "type": "array",
            "description": "Product keywords to search (one per line)",
            "editor": "stringList"
        },
        "urls": {
            "title": "Product URLs",
            "type": "array",
            "description": "Lazada search/category URLs (one per line)",
            "editor": "stringList"
        },
        "country": {
            "sectionCaption": "Country",
            "title": "Country",
            "type": "string",
            "description": "Country site to search",
            "editor": "select",
            "default": "my",
            "enum": ["sg", "my", "th", "ph", "id", "vn"],
            "enumTitles": ["Singapore", "Malaysia", "Thailand", "Philippines", "Indonesia", "Vietnam"]
        },
        "searchAllCountries": {
            "title": "Search All Countries",
            "type": "boolean",
            "description": "Search this keyword across ALL 6 countries (overrides Country setting)",
            "default": false
        },
        "maxPages": {
            "sectionCaption": "Pagination",
            "title": "Max Pages per Country",
            "type": "integer",
            "description": "Number of search result pages to scrape per country (~40 products per page)",
            "default": 1,
            "minimum": 1,
            "maximum": 20
        },
        "sortBy": {
            "sectionCaption": "Filters & Sorting",
            "title": "Sort By",
            "type": "string",
            "description": "Sort order for search results",
            "editor": "select",
            "default": "relevance",
            "enum": ["relevance", "priceAsc", "priceDesc", "ratingDesc", "newest", "soldDesc"],
            "enumTitles": ["Relevance", "Price: Low to High", "Price: High to Low", "Rating: High to Low", "Newest First", "Best Selling"]
        },
        "minPrice": {
            "title": "Min Price",
            "type": "number",
            "description": "Minimum price in local currency (optional)",
            "editor": "number"
        },
        "maxPrice": {
            "title": "Max Price",
            "type": "number",
            "description": "Maximum price in local currency (optional)",
            "editor": "number"
        },
        "minRating": {
            "title": "Min Rating",
            "type": "number",
            "description": "Minimum rating (1.0 - 5.0, optional)",
            "editor": "number"
        },
        "comparePrices": {
            "sectionCaption": "Cross-Country Comparison",
            "title": "Compare Prices Across Countries",
            "type": "boolean",
            "description": "Generate a price comparison report when searching multiple countries",
            "default": false
        },
        "proxyConfiguration": {
            "sectionCaption": "Proxy Settings",
            "title": "Proxy Configuration",
            "type": "object",
            "description": "Proxy settings. Leave disabled for direct connection.",
            "editor": "proxy",
            "prefill": {
                "useApifyProxy": false
            }
        }
    },
    "required": []
}
